{
  "name": "sms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "School Management System - REST API (Node.js + Express + TypeScript + Mongoose)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tests/foundation.test.mjs",
    "test:auth": "node tests/auth.test.mjs",
    "test:academic": "node tests/academic.test.mjs",
    "test:attendance": "node tests/attendance.test.mjs",
    "test:exams": "node tests/exams.test.mjs",
    "test:finance": "node tests/finance.test.mjs",
    "test:prompt7": "node tests/prompt7.test.mjs",
    "test:prompt9": "node tests/prompt9.test.mjs",
    "test:prompt10": "node tests/prompt10.test.mjs",
    "test:saas": "node tests/saas.test.mjs",
    "seed": "tsx src/scripts/seed.ts",
    "demo:seed": "tsx src/scripts/seedDemoSchool.ts",
    "demo:delete": "tsx src/scripts/deleteDemoSchool.ts",
    "demo:reset": "tsx src/scripts/resetDemoSchool.ts",
    "bootstrap:platform-admin": "tsx src/scripts/bootstrapPlatformAdmin.ts",
    "migrate:saas": "tsx src/scripts/migrateSaas.ts",
    "storage:report": "tsx src/scripts/storageReport.ts",
    "indexes:audit": "tsx src/scripts/indexAudit.ts",
    "indexes:sync": "tsx src/scripts/indexAudit.ts --sync",
    "backup": "tsx src/scripts/backupDatabase.ts",
    "restore": "tsx src/scripts/restoreDatabase.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "ts-morph": "^28.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.12",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "supertest": "^7.3.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0"
  }
}
